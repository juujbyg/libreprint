#!/bin/sh
set -e

case "$1" in
    configure)
        udevadm control --reload-rules >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable --now libreprint-netwatch.service || true
        fi
        # Configure printers that are already connected, without blocking dpkg.
        (/usr/bin/libreprint auto --all >/var/log/libreprint-install.log 2>&1 &) || true
        ;;
    *)
        ;;
esac

exit 0
